<section>
    <div class="container py-5 my-5 ">
        <asp:Repeater ID="rptSpeech" runat="server">
            <ItemTemplate>
                <div class="row university-president-speech">
                    <div class="col-12 col-lg-6  order-lg-0 order-1  p-5">
                        <div class="p-0">
                            <h2 class="title text-dark fw-bold px-2 border-start border-primary mb-4 lh-1">
                              <%# Eval("ParagraphTitleAr") %>
                            </h2>

                            <p class="text-muted h5 mb-3 lh-base text-justify">
                                <%# Eval("ParagraphTextAr") %>
                            </p>
                            <br>
                        </div>

                    </div>
                    <%--<div class="col-12 col-lg-6 mt-5 py-5  mb-5  text-start">
                        <div class="border-behind-img position-relative object-fit-cover">
                            <img src="<%# Eval("ImageUrl") %>" class=" img-fluid ms-auto d-block mx-5 w-75"
                                height="60%" alt="...">
                        </div>
                    </div>--%>


