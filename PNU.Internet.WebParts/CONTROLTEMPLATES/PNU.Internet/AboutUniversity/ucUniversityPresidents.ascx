                    <!-- Right Tabs -->
                    <div class="col-xl-7 mt-xl-0 mt-4">
                        <div class="card border-0 rounded-4 h-100 bg-sa-50">
                            <ul class="nav nav-tabs nav-pills nav-fill nav-justified mb-0 bg-sa-50 p-0 rounded-4 rounded-bottom-0 w-100 d-flex"
                                id="myTab" role="tablist">

                                <li class="nav-item" role="presentation">
                                    <button class="nav-link h5 py-3 active rounded-4 rounded-bottom-0 rounded-end-0"
                                        id="home-tab" data-bs-toggle="tab" data-bs-target="#z1-tab-pane" type="button"
                                        role="tab" aria-controls="z1-tab-pane" aria-selected="true">
                                        السيرة الذاتية
                                    </button>
                                </li>

                                <li class="nav-item" role="presentation">
                                    <button class="nav-link h5 py-3 rounded-0" id="college2-tab" data-bs-toggle="tab"
                                        data-bs-target="#z2-tab-pane" type="button" role="tab"
                                        aria-controls="z2-tab-pane" aria-selected="false">
                                        العضويات
                                    </button>
                                </li>

                                <li class="nav-item" role="presentation">
                                    <button class="nav-link h5 py-3 rounded-0" id="college3-tab" data-bs-toggle="tab"
                                        data-bs-target="#z3-tab-pane" type="button" role="tab"
                                        aria-controls="z3-tab-pane" aria-selected="false"
                                        style="min-width: 100%; width: max-content;">
                                        الأوسمة والجوائز
                                    </button>
                                </li>

                                <li class="nav-item" role="presentation">
                                    <button class="nav-link h5 py-3 rounded-4 rounded-bottom-0 rounded-start-0"
                                        id="college4-tab" data-bs-toggle="tab" data-bs-target="#z4-tab-pane"
                                        type="button" role="tab" aria-controls="z4-tab-pane" aria-selected="false"
                                        style="min-width: 100%; width: max-content;">
                                        الخبرات العملية
                                    </button>
                                </li>
                            </ul>

                            <div class="card-body p-0">
                                <div class="p-5 tab-content" id="myTabContent">

                                    <!-- Biography -->
                                    <div class="tab-pane fade show active" id="z1-tab-pane" role="tabpanel" tabindex="0">
                                        <h3 class="h3 text-dark fw-bold mb-3">
                                            <asp:Literal ID="litBiographyTitle" runat="server" />
                                        </h3>
                                        <p class="text-light-emphasis fs-5 mb-5 text-justify">
                                            <asp:Literal ID="litBiographyText" runat="server" />
                                        </p>
                                    </div>

                                    <!-- Memberships -->
                                    <div class="tab-pane fade" id="z2-tab-pane" role="tabpanel" tabindex="0">
                                        <h3 class="h3 text-dark fw-bold mb-3">العضويات:</h3>

                                        <div>
                                            <asp:Repeater ID="rptMemberships" runat="server">
                                                <ItemTemplate>
                                                    <div class="d-flex align-items-start mb-4">
                                                        <svg class="bi me-3 mt-1 align-self-center" width="14" height="14">
                                                            <use xlink:href="#circle-dots" />
                                                        </svg>
                                                        <p class="text-muted card-text fw-normal h5 mb-0">
                                                            <%# Eval("MembershipTextAr") %>
                                                        </p>
                                                    </div>
                                                </ItemTemplate>
                                            </asp:Repeater>
                                        </div>
                                    </div>

                                    <!-- Awards -->
                                    <div class="tab-pane fade" id="z3-tab-pane" role="tabpanel" tabindex="0">
                                        <h3 class="h3 text-dark fw-bold mb-3">الأوسمة والجوائز:</h3>

                                        <div>
                                            <asp:Repeater ID="rptAwards" runat="server">
                                                <ItemTemplate>
                                                    <div class="d-flex align-items-start mb-4">
                                                        <svg class="bi me-3 mt-1 align-self-center" width="14" height="14">
                                                            <use xlink:href="#circle-dots" />
                                                        </svg>
                                                        <p class="text-muted card-text fw-normal h5 mb-0">
                                                            <%# Eval("AwardTextAr") %>
                                                        </p>
                                                    </div>
                                                </ItemTemplate>
                                            </asp:Repeater>
                                        </div>
                                    </div>

                                    <!-- Experiences -->
                                    <div class="tab-pane fade" id="z4-tab-pane" role="tabpanel" tabindex="0">
                                        <div class="card mb-3 p-3 rounded-3 border-0">
                                            <div class="row g-0">
                                                <div class="col-md-12">
                                                    <div class="card-body py-0">

                                                        <asp:Repeater ID="rptExperiences" runat="server">
                                                            <ItemTemplate>
                                                                <div>
                                                                    <h5 class="card-title mt-2 fw-bold mb-1">
                                                                        <%# Eval("JobTitleAr") %>
                                                                    </h5>

                                                                    <p class="mb-2 card-text text-muted d-flex-inline align-items-center">
                                                                        <%# Eval("OrganizationAr") %>، <%# Eval("LocationAr") %>
                                                                    </p>

                                                                    <p class="mb-3 card-text text-muted d-flex-inline align-items-center">
                                                                        <svg class="bi me-1 mb-1" width="20" height="20">
                                                                            <use xlink:href="#calendar"></use>
                                                                        </svg>
                                                                        <%# Eval("PeriodAr") %>
                                                                    </p>
                                                                </div>

                                                                <%--<asp:PlaceHolder ID="phDivider" runat="server"
                                                                    Visible='<%# Container.ItemIndex < ((System.Collections.ICollection)Container.Parent.Parent).Count - 1 %>'>
                                                                    <hr class="border border-1 opacity-50 my-4 mb-3" />
                                                                </asp:PlaceHolder>--%>
                                                            </ItemTemplate>
                                                        </asp:Repeater>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /Right Tabs -->

                
                </div>
            </div>
        </section>
