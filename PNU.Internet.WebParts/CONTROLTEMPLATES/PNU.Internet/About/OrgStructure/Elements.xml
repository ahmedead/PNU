      Assembly="$SharePoint.Project.AssemblyFullName$"
      Namespace="PNU.Internet.WebParts.CONTROLTEMPLATES.PNU.Internet.About.OrgStructure"
      TypeName="*"
      Safe="True"
      SafeAgainstScript="False" />

</Elements>
