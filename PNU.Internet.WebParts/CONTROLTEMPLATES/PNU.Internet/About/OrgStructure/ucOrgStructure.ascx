<%-- Unit data loaded from the OrgStructureUnits list, emitted by code-behind. --%>
<asp:Literal ID="litUnitsJson" runat="server" EnableViewState="false" />

<script>
    (function () {
        var initOrgStructureTooltip = function () {
            var tooltip = document.getElementById("orgUnitTooltip");
            var tooltipTitle = document.getElementById("orgUnitTooltipTitle");
            var tooltipText = document.getElementById("orgUnitTooltipText");
            var tooltipIcon = document.getElementById("orgUnitTooltipIcon");
            var tooltipLink = document.getElementById("orgUnitTooltipLink");
            var tooltipDisabledAction = document.getElementById("orgUnitTooltipDisabledAction");

            if (!tooltip || !tooltipTitle || !tooltipText || !tooltipIcon || !tooltipLink || !tooltipDisabledAction) {
                return;
            }

            // Fallback labels come from the injected config so they stay bilingual.
            var cfg = window.__pnuOrgConfig || { fallbackTitle: "وحدة تنظيمية", noDetails: "لا توجد صفحة تفاصيل" };
            // Units are supplied by the server from the SharePoint list.
            var unitDescriptors = window.__pnuOrgUnits || [];

            var registerUnit = function (node, unit, href) {
                href = href || "";
                node.setAttribute("data-org-unit", "true");
                node.setAttribute("data-title", unit.title);
                node.setAttribute("data-desc", unit.desc);
                node.setAttribute("data-badge", unit.badge);
                node.setAttribute("data-meta", unit.meta);
                node.setAttribute("data-icon", unit.icon);
                node.setAttribute("data-theme", unit.theme);
                node.setAttribute("data-href", href);
                node.setAttribute("data-has-link", href ? "true" : "false");
                node.setAttribute("tabindex", "0");
                node.setAttribute("role", "group");
                node.setAttribute("aria-label", unit.title + "، " + unit.badge + ". " + unit.desc);
            };

            unitDescriptors.forEach(function (unit) {
                if (!unit.selector) { return; }
                var node = document.querySelector(".org-structure-svg " + unit.selector);
                if (!node) { return; }
                registerUnit(node, unit, unit.href);
            });

            var getGenericUnitDescriptor = function (node) {
                var fill = node.getAttribute("fill") || "";
                var stroke = node.getAttribute("stroke") || "";
                var g = cfg.generic || {};
                var title = cfg.fallbackTitle;
                var badge = g.defaultBadge || "";
                var icon = "hgi-hierarchy";

                if (stroke.indexOf("primary-400") > -1) { title = g.councilTitle; badge = g.councilBadge; icon = "hgi-user-group"; }
                else if (fill.indexOf("primary-700") > -1) { title = g.agencyTitle; badge = g.agencyBadge; }
                else if (fill.indexOf("primary-500") > -1) { title = g.deanshipTitle; badge = g.deanshipBadge; }
                else if (fill.indexOf("primary-200") > -1) { title = g.deptTitle; badge = g.deptBadge; }
                else if (fill.indexOf("primary-100") > -1) { title = g.centerTitle; badge = g.centerBadge; }
                else if (stroke.indexOf("primary-200") > -1) { title = g.collegeTitle; badge = g.collegeBadge; }
                else if (fill.indexOf("primary-400") > -1) { title = g.entityTitle; badge = g.entityBadge; }

                return {
                    title: title || cfg.fallbackTitle,
                    desc: g.defaultDesc || "",
                    badge: badge || "",
                    meta: g.defaultMeta || "",
                    icon: icon,
                    theme: "primary"
                };
            };

            var organizationBoxes = Array.prototype.slice
                .call(document.querySelectorAll('.org-structure-svg rect[rx="8"]'))
                .filter(function (node) {
                    var width = Number(node.getAttribute("width"));
                    var height = Number(node.getAttribute("height"));
                    return width >= 130 && width <= 280 && height >= 38 && height <= 85;
                });

            organizationBoxes.forEach(function (node) {
                if (!node.hasAttribute("data-org-unit")) {
                    registerUnit(node, getGenericUnitDescriptor(node));
                }
            });

            var units = document.querySelectorAll(".org-structure-svg [data-org-unit]");
            var finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
            var activeUnit = null;
            var frameId = null;
            var hideTimer = null;
            var lastPoint = { x: 0, y: 0 };

            var populateTooltip = function (node) {
                var d = node.dataset;
                tooltipTitle.textContent = d.title || cfg.fallbackTitle;
                tooltipText.textContent = d.desc || "";
                tooltipIcon.className = "hgi hgi-stroke " + (d.icon || "hgi-hierarchy") + " fs-3";

                if (d.href) {
                    tooltipLink.href = d.href;
                    tooltipLink.setAttribute("aria-label", d.title || cfg.fallbackTitle);
                    tooltipLink.hidden = false;
                    tooltipDisabledAction.hidden = true;
                } else {
                    tooltipLink.removeAttribute("href");
                    tooltipLink.hidden = true;
                    tooltipDisabledAction.hidden = false;
                    tooltipDisabledAction.setAttribute("aria-label", (d.title || cfg.fallbackTitle) + "، " + cfg.noDetails);
                }
            };

            var queuePosition = function (x, y) {
                lastPoint = { x: x, y: y };
                if (frameId) { return; }
                frameId = window.requestAnimationFrame(function () {
                    frameId = null;
                    if (tooltip.hidden) { return; }
                    var spacing = 20;
                    var bounds = tooltip.getBoundingClientRect();
                    var left = lastPoint.x + spacing;
                    var top = lastPoint.y - (bounds.height / 2);
                    if (left + bounds.width > window.innerWidth - 16) { left = lastPoint.x - bounds.width - spacing; }
                    if (left < 16) { left = 16; }
                    if (top + bounds.height > window.innerHeight - 16) { top = window.innerHeight - bounds.height - 16; }
                    if (top < 16) { top = 16; }
                    tooltip.style.left = Math.round(left) + "px";
                    tooltip.style.top = Math.round(top) + "px";
                });
            };

            var cancelScheduledHide = function () {
                if (!hideTimer) { return; }
                window.clearTimeout(hideTimer);
                hideTimer = null;
            };

            var focusPosition = function (node) {
                var rect = node.getBoundingClientRect();
                return { x: rect.right - 12, y: rect.top + (rect.height / 2) };
            };

            var showTooltip = function (node) {
                cancelScheduledHide();
                if (activeUnit && activeUnit !== node) { activeUnit.classList.remove("is-active"); }
                activeUnit = node;
                activeUnit.classList.add("is-active");
                populateTooltip(node);
                tooltip.hidden = false;
                tooltip.setAttribute("aria-hidden", "false");
                var point = focusPosition(node);
                queuePosition(point.x, point.y);
                window.requestAnimationFrame(function () { tooltip.classList.add("is-visible"); });
            };

            var hideTooltip = function () {
                if (activeUnit) { activeUnit.classList.remove("is-active"); }
                activeUnit = null;
                tooltip.classList.remove("is-visible");
                tooltip.hidden = true;
                tooltip.setAttribute("aria-hidden", "true");
            };

            var scheduleHide = function () {
                cancelScheduledHide();
                hideTimer = window.setTimeout(function () { hideTimer = null; hideTooltip(); }, 240);
            };

            units.forEach(function (node) {
                node.addEventListener("pointerenter", function (event) {
                    if (!finePointer.matches || event.pointerType !== "mouse") { return; }
                    showTooltip(node);
                });
                node.addEventListener("pointerleave", function (event) {
                    if (event.pointerType !== "mouse") { return; }
                    scheduleHide();
                });
                node.addEventListener("focus", function () { showTooltip(node); });
                node.addEventListener("blur", function () { scheduleHide(); });
            });

            tooltip.addEventListener("pointerenter", function (event) { if (event.pointerType === "mouse") { cancelScheduledHide(); } });
            tooltip.addEventListener("pointerleave", function (event) { if (event.pointerType === "mouse") { scheduleHide(); } });
            tooltip.addEventListener("focusin", function () { cancelScheduledHide(); });
            tooltip.addEventListener("focusout", function () { scheduleHide(); });

            window.addEventListener("scroll", function () {
                if (!activeUnit || tooltip.hidden) { return; }
                if (document.activeElement === activeUnit) {
                    var point = focusPosition(activeUnit);
                    queuePosition(point.x, point.y);
                    return;
                }
                queuePosition(lastPoint.x, lastPoint.y);
            }, { passive: true });

            window.addEventListener("resize", function () { hideTooltip(); });
            document.addEventListener("keydown", function (event) { if (event.key === "Escape") { hideTooltip(); } });
        };

        window.addEventListener("load", function () {
            initOrgStructureTooltip();
        });
    })();
</script>
