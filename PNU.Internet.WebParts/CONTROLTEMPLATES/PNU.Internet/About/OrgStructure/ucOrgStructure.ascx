<%@ Control Language="C#" AutoEventWireup="true" CodeBehind="ucOrgStructure.ascx.cs" Inherits="PNU.Internet.WebParts.CONTROLTEMPLATES.PNU.Internet.About.OrgStructure.ucOrgStructure" %>
<%--
    ucOrgStructure — PNU organizational-structure chart (DGA / RTL).
    The SVG geometry is fixed; each <rect> is paired to a list item via its
    coordinate selector. Unit content (title / description / badge / meta / icon /
    theme / link) is loaded from the OrgStructureUnits list and emitted as JSON
    into the page below, then bound by the client script.
--%>
<section class="py-5" data-aos="fade-up">
    <div class="container">
        <style>
            .org-structure-svg path,
            .org-structure-svg circle {
                pointer-events: none;
            }

            .org-structure-stage {
                position: relative;
                isolation: isolate;
            }

            .org-structure-svg [data-org-unit] {
                cursor: pointer;
                pointer-events: all;
                transition: filter 0.24s cubic-bezier(0.22, 1, 0.36, 1),
                    fill 0.24s cubic-bezier(0.22, 1, 0.36, 1),
                    stroke 0.24s cubic-bezier(0.22, 1, 0.36, 1),
                    opacity 0.24s cubic-bezier(0.22, 1, 0.36, 1);
            }

            .org-structure-svg rect[fill="var(--dga-primary-200)"] + path {
                fill: var(--dga-primary-950);
            }

            .org-unit-tooltip {
                position: fixed;
                top: 0;
                left: 0;
                width: min(22rem, calc(100vw - 1.5rem));
                pointer-events: none;
                opacity: 0;
                transform: translate3d(0, 0.75rem, 0) scale(0.98);
                transform-origin: top right;
                transition: opacity 0.18s ease, transform 0.18s ease;
                z-index: 20;
            }

            .org-unit-tooltip.is-visible {
                opacity: 1;
                transform: translate3d(0, 0, 0) scale(1);
                pointer-events: auto;
            }

            @media (hover: hover) and (pointer: fine) {
                .org-structure-svg [data-org-unit]:hover,
                .org-structure-svg [data-org-unit].is-active {
                    filter: drop-shadow(0 12px 18px color-mix(in srgb, var(--dga-primary-950) 18%, transparent));
                }

                .org-structure-svg [data-org-unit][fill]:hover,
                .org-structure-svg [data-org-unit][fill].is-active {
                    opacity: 0.94;
                }

                .org-structure-svg [data-org-unit][stroke]:not([fill]):hover,
                .org-structure-svg [data-org-unit][stroke]:not([fill]).is-active {
                    fill: var(--dga-primary-25);
                    stroke: var(--dga-primary);
                }
            }

            @media (hover: none), (pointer: coarse) {
                .org-structure-svg [data-org-unit] {
                    cursor: default;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .org-structure-svg [data-org-unit],
                .org-unit-tooltip {
                    transition: none;
                }
            }
        </style>
