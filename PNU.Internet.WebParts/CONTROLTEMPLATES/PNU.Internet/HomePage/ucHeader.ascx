<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        var canonical = document.querySelector('link[rel="canonical"]');
        if (canonical) {
            var href = canonical.getAttribute("href");
            if (href.includes(":443")) {
                var cleanHref = href.replace(":443", "");
                canonical.setAttribute("href", cleanHref);
            }
        }


        // Function to tag the Muneer elements for Google
        const blockFromGoogle = () => {
            const elements = [
                document.getElementById('muneer-useful-links'),
                document.getElementById('muneer-useful-links-box'),
                document.querySelector('.muneer-useful-links') // checking class just in case
            ];

            elements.forEach(el => {
                if (el) {
                    el.setAttribute('data-nosnippet', '');
                }
            });
        };

        // Run once immediately
        blockFromGoogle();

        // Run again after 2 seconds to catch late-loading widgets
        setTimeout(blockFromGoogle, 2000);


    });
</script>




